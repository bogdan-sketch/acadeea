# Database
DATABASE_URL=postgresql://acadeea:acadeea_dev@localhost:5432/acadeea?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate RS256 keys: openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=acadeea
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# App
PORT=3000
NODE_ENV=development
# Comma list; entries may use a subdomain wildcard, e.g. https://*.horae.ca
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://*.localhost:3000

# Multi-tenancy (Horae)
# warn = log unscoped queries but run them (rollout default) · strict = fail closed · off = disabled
TENANT_ENFORCEMENT=warn
# Org web origins become https://<slug>.<BASE_DOMAIN> (empty = FRONTEND_URL, local dev)
BASE_DOMAIN=
# Comma list of emails allowed to provision/list organizations (POST/GET /api/v1/organizations)
PLATFORM_ADMIN_EMAILS=
# Comma list of emails allowed to DOWNLOAD org snapshots (GET /api/v1/backups/snapshots/:id/download).
# Unset/empty falls back to: admin@acadeea.ro,sergiu@tigan.dev
BACKUP_ADMIN_EMAILS=admin@acadeea.ro,sergiu@tigan.dev

# Social sign-in (Sign in with Apple / Google). Comma lists of ALLOWED AUDIENCES
# (the `aud` claim of the provider id_token). Empty = that provider is disabled.
# Apple: native bundle ids + the web Services ID, e.g. ca.horae.app,ca.horae.app.test,ca.horae.signin
APPLE_AUDIENCES=
# Google: the web + iOS OAuth client ids
GOOGLE_AUDIENCES=

# Observability — all OPTIONAL. Leave blank to disable (the app boots fine without them).
# Sentry (error + performance monitoring). Empty DSN = Sentry is a complete no-op.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# PostHog (backend product analytics). Empty API key = analytics no-op.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
