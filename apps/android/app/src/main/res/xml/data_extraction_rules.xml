<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup / device transfer of app data: the session store is encrypted with a
     Keystore key that never leaves the device, so a restored copy can't be read (it used to
     crash the app at launch after a reinstall or phone change). Users simply log in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
