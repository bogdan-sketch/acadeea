meta {
  name: Login Cofetar
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{cofetarEmail}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("accessToken", res.getBody().accessToken);
    bru.setVar("refreshToken", res.getBody().refreshToken);
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("has accessToken", function() {
    expect(res.getBody().accessToken).to.be.a('string');
  });
  test("role is COFETAR", function() {
    expect(res.getBody().user.role).to.equal('COFETAR');
  });
}
