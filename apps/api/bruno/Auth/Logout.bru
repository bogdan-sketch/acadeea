meta {
  name: Logout
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

tests {
  test("status 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
