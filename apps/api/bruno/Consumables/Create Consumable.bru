meta {
  name: Create Consumable
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/consumables
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Cutii tort 30cm",
    "minimumStock": 10
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("consumableId", res.getBody().id);
  }
}

tests {
  test("status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("has id", function() {
    expect(res.getBody().id).to.be.a('string');
  });
  test("title matches", function() {
    expect(res.getBody().title).to.equal('Cutii tort 30cm');
  });
  test("status is ACTIVE", function() {
    expect(res.getBody().status).to.equal('ACTIVE');
  });
}
