meta {
  name: Get Consumable
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/consumables/{{consumableId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("has correct id", function() {
    expect(res.getBody().id).to.equal(bru.getVar("consumableId"));
  });
  test("has title", function() {
    expect(res.getBody().title).to.be.a('string');
  });
}
