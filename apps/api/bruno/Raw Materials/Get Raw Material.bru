meta {
  name: Get Raw Material
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/raw-materials/{{rawMaterialId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("has correct id", function() {
    expect(res.getBody().id).to.equal(bru.getVar("rawMaterialId"));
  });
  test("has title", function() {
    expect(res.getBody().title).to.be.a('string');
  });
  test("has unit", function() {
    expect(res.getBody().unit).to.be.a('string');
  });
  test("has storageType", function() {
    expect(res.getBody().storageType).to.be.a('string');
  });
}
