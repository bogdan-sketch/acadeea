meta {
  name: Update Raw Material
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/raw-materials/{{rawMaterialId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Faina 000 Premium",
    "producer": "Baneasa Gold"
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("title updated", function() {
    expect(res.getBody().title).to.equal('Faina 000 Premium');
  });
  test("producer updated", function() {
    expect(res.getBody().producer).to.equal('Baneasa Gold');
  });
}
