meta {
  name: Create Movement (Ajustare)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/stock/movements
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "rawMaterialId": "{{rawMaterialId}}",
    "movementType": "AJUSTARE",
    "quantity": -5,
    "unit": "KILOGRAME",
    "referenceNote": "Ajustare inventar - pierderi depozitare"
  }
}

tests {
  test("status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("movementType is AJUSTARE", function() {
    expect(res.getBody().movementType).to.equal('AJUSTARE');
  });
  test("quantity matches", function() {
    expect(res.getBody().quantity).to.equal(-5);
  });
}
