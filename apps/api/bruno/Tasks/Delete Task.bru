meta {
  name: Delete Task
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/v1/tasks/{{taskId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("has id", function() {
    expect(res.getBody().id).to.equal(bru.getVar("taskId"));
  });
}
