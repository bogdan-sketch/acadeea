meta {
  name: Get Task
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/tasks/{{taskId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("has correct id", function() {
    expect(res.getBody().id).to.equal(bru.getVar("taskId"));
  });
  test("has title", function() {
    expect(res.getBody().title).to.be.a('string');
  });
  test("has status", function() {
    expect(res.getBody().status).to.be.a('string');
  });
  test("has recipeId", function() {
    expect(res.getBody().recipeId).to.be.a('string');
  });
  test("has statusHistory", function() {
    expect(res.getBody().statusHistory).to.be.an('array');
  });
}
