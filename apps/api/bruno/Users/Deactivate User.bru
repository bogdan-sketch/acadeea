meta {
  name: Deactivate User
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/users/{{createdUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("isActive is false", function() {
    expect(res.getBody().isActive).to.equal(false);
  });
}
