// ============================================================================
// Horae — Prisma Schema
// ============================================================================
// Bakery/pastry production management system.
// PostgreSQL datasource with prisma-client-js generator.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum UserRole {
  ADMINISTRATOR
  SEF_LABORATOR
  SEF_EVENIMENTE
  COFETAR
  PATISER
  AJUTOR_COFETAR
  MAGAZIONER
}

// ============================================================================
// Dynamic RBAC — Roles & Permissions
// ============================================================================

/// A named role with dynamic permissions. System roles (isSystem=true) cannot be deleted.
/// Per-organization: each org has its own role rows (standard set cloned at org creation).
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @db.Uuid
  name           String
  slug           String
  isSystem       Boolean  @default(false)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  users        User[]
  invitations  UserInvitation[]

  // Constraints
  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId])
}

/// A single permission rule: (action, subject) granted to a role.
model RolePermission {
  id      String @id @default(uuid()) @db.Uuid
  roleId  String @db.Uuid
  action  String // create | read | update | delete | manage
  subject String // Recipe | Task | Order | all | etc.

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Constraints
  @@unique([roleId, action, subject])
  @@index([roleId])
}

enum UnitType {
  MILIGRAME
  GRAME
  KILOGRAME
  MILILITRI
  LITRI
  BUCATI
  LINGURITE
  LINGURI
  CANI
  OUNCES
  POUNDS
}

enum StorageType {
  COLD
  WARM
  FROZEN
}

enum MaterialStatus {
  ACTIVE
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

enum RecipeType {
  FINAL
  SEMIPREPARAT
}

/// Admin-managed recipe categories (dynamic, not an enum). Per-organization.
model RecipeCategoryConfig {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @db.Uuid
  name           String
  kind           String   @default("RECIPE") // MATERIE_PRIMA | SEMIPREPARAT | PRODUS_FINIT (type separation)
  parentId       String?  @db.Uuid // null = super-category; set = sub-category
  color          String? // hex, set on super-categories; sub-categories inherit the parent's color
  isSystem       Boolean  @default(false) // seeded, cannot be renamed/deleted
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id])
  parent       RecipeCategoryConfig?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     RecipeCategoryConfig[] @relation("CategoryHierarchy")

  @@unique([organizationId, name, kind])
  @@index([parentId])
  @@index([organizationId])
}

/// A super-category (dynamic). `kind` is its stable slug — the 3 seeded ones
/// (MATERIE_PRIMA / SEMIPREPARAT / PRODUS_FINIT) are isSystem and drive entity
/// tagging; users can add more. Sub-categories (RecipeCategoryConfig rows with
/// the same `kind`) inherit this colour.
model CategoryKindColor {
  organizationId String  @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @db.Uuid
  kind           String
  color          String
  name           String?
  sortOrder      Int     @default(0)
  isSystem       Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, kind])
}

enum TaskStatus {
  DE_FACUT
  BLOCAT
  IN_LUCRU
  FINALIZAT
  ANULAT
}

/// Who sees a task besides users with `manage Task` (administrators always see everything):
/// ASSIGNED = only the assignee (and subtask assignees), EVERYONE = anyone who can read tasks,
/// SELECTED = the assignee plus the users in Task.visibleToIds.
enum TaskVisibility {
  ASSIGNED
  EVERYONE
  SELECTED
}

enum StockMovementType {
  INTRARE
  IESIRE_PRODUCTIE
  AJUSTARE
  REZERVARE
  ELIBERARE
  INTRARE_PRODUCTIE
  /// Raw materials consumed for R&D/test bakes — no task, no recipe output.
  IESIRE_TESTE
  /// Finished goods sold (POS report / manual / website) — written by a confirmed SalesDeduction.
  IESIRE_VANZARE
}

enum PieceType {
  SAC
  CUTIE
  BIDON
  PUNGA
  RECIPIENT
  BUCATA
}

enum OrderStatus {
